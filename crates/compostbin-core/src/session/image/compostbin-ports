#!/bin/sh
# The guest half of host port forwarding, and the container's own process when
# the manifest declares [host] ports: each one on this guest's localhost is
# relayed to a unix socket, where compostbin listens on the host's behalf.
# A shell script for the same reason as compostbin-host.
#
# The sockets are not mounted files. `container` turns a socket passed as
# --volume into a relay of its own, so what is here is an end it created at
# start; nothing on a network address is involved, and no other container can
# reach these.
set -eu

sockets=/run/compostbin/ports

for port in "$@"; do
  socket="$sockets/$port.sock"

  if [ -S "$socket" ]; then
    socat "TCP-LISTEN:$port,bind=127.0.0.1,fork,reuseaddr" "UNIX-CONNECT:$socket" &
  else
    echo "compostbin-ports: no socket at $socket; port $port is not forwarded" >&2
  fi
done

# The container lives as long as this does, whether or not a relay survives.
exec sleep infinity
