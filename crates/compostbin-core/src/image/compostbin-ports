#!/bin/sh
# Relays each <port>:<vsock port> argument from guest localhost to the host over vsock.
set -eu

# VMADDR_CID_HOST.
host=2

for forward in "$@"; do
  port=${forward%%:*}
  vsock=${forward#*:}

  socat "TCP-LISTEN:$port,bind=127.0.0.1,fork,reuseaddr" "VSOCK-CONNECT:$host:$vsock" &
done

exec sleep infinity
