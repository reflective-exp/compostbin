#!/bin/sh
# The guest half of host port forwarding, and the container's own process when
# the manifest declares [host] ports: each port on this guest's localhost is
# relayed over vsock to the host, where compostbin listens on its behalf.
# A shell script for the same reason as compostbin-host.
#
# Each argument is <port>:<vsock port>. Vsock reaches only the host of this VM:
# no network address is involved, and no other container can reach them.
set -eu

# The host's context ID, the same in every VM.
host=2

for forward in "$@"; do
  port=${forward%%:*}
  vsock=${forward#*:}

  socat "TCP-LISTEN:$port,bind=127.0.0.1,fork,reuseaddr" "VSOCK-CONNECT:$host:$vsock" &
done

# The container lives as long as this does, whether or not a relay survives.
exec sleep infinity
