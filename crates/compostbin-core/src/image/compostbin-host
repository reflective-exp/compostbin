#!/bin/sh
# Runs an allowlisted command on the host via the spool, forwarding stdio and exit status.
# Output arrives as renamed chunk files because a file the host appends to stays stale here.
set -eu

spool=/run/compostbin/host

if [ ! -d "$spool/requests" ]; then
  echo "compostbin-host: this session has no host channel; declare [host.commands] in the manifest" >&2
  exit 127
fi

if [ "$#" -lt 1 ]; then
  echo "usage: compostbin-host <command> [arguments...]" >&2
  exit 64
fi

# Requests are one field per line.
newline='
'
for argument in "$@"; do
  case "$argument" in
    *"$newline"*)
      echo "compostbin-host: an argument may not contain a newline" >&2
      exit 126
      ;;
  esac
done

# Timestamp first so ids sort in arrival order; the random suffix keeps concurrent callers apart.
id="$(date +%s)-$$-$(od -An -N2 -tu2 < /dev/urandom | tr -d ' ')"
responses="$spool/responses"
input="$responses/$id.in"
status="$responses/$id.status"
tty="$responses/$id.tty"

# Relies on fixed-width sequence numbers for glob order.
drain() {
  for chunk in "$responses/$id.$1."*; do
    [ -e "$chunk" ] || continue
    case "$chunk" in
      *.partial) continue ;;
    esac
    cat "$chunk"
    rm -f "$chunk"
  done
}

# The .eof marker tells the host input has ended.
: > "$input"
# A background job in a non-interactive shell gets stdin from /dev/null.
exec 3<&0
( cat <&3 >> "$input" 2>/dev/null || true; : > "$input.eof" ) &
forwarder=$!

if [ -t 1 ]; then
  : > "$tty"
fi

printf '%s\n' "$@" > "$spool/requests/$id.partial"
mv "$spool/requests/$id.partial" "$spool/requests/$id.request"

# Status is written last, so checking it before draining guarantees the final drain sees every chunk.
delay=0.01
while :; do
  finished=0
  if [ -f "$status" ]; then
    finished=1
  fi

  drain out
  drain err >&2

  if [ "$finished" -eq 1 ]; then
    break
  fi

  sleep "$delay"
  case "$delay" in
    0.01) delay=0.02 ;;
    0.02) delay=0.05 ;;
    *) delay=0.1 ;;
  esac
done

code=$(cat "$status")
kill "$forwarder" 2>/dev/null || true
rm -f "$input" "$input.eof" "$status" "$tty"
exit "$code"
