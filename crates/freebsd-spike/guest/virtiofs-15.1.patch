+
+/* Struct for the file system instance. Provided by the host. */
+struct vtfs_config {
+	/* UTF-8 File system tag. */
+	uint8_t tag[TAG_SIZE];
+	/* Number of request queues. */
+	uint32_t num_request_queues;
