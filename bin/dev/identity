#!/usr/bin/env sh
#
# Prints the codesigning identity belonging to a team id.
#
# `codesign --sign` matches against a certificate's common name, and a team id
# does not appear there — an "Apple Development: Name (XXXXXXXXXX)" certificate
# carries its own certificate id in that position, not the team's. The team id
# is the OU, so finding it means reading the certificate rather than the name.
#
# Its own script so it can be run, and checked, without signing anything.

set -e

team="${1:?usage: bin/dev/identity <team-id>}"

security find-identity -v -p codesigning |
  sed -n 's/^ *[0-9]*) \([0-9A-F][0-9A-F]*\) "\(.*\)"$/\1 \2/p' |
  while read -r hash name; do
    # Both `subject=CN=…, OU=…` and `subject= /CN=…/OU=…` reduce to one field
    # per line, whichever openssl is on PATH.
    organizational_unit="$(
      security find-certificate -c "$name" -p 2>/dev/null |
        openssl x509 -noout -subject 2>/dev/null |
        tr ',/' '\n\n' |
        sed -n 's/^ *OU *= *//p' |
        head -1
    )"

    if [ "$organizational_unit" = "$team" ]; then
      printf '%s\n' "$hash"
      break
    fi
  done
