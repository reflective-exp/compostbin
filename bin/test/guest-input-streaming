#!/bin/sh
# Measures guest-to-host streaming over a bind mount. Run it INSIDE a session; it
# drives both halves.
#
# A file the guest opens while the host is still appending stays stale in the
# guest forever, so command output travels as renamed chunks. This measures the
# other direction: the guest appends on a schedule while a host-side test reads.
#
# The appender waits for the host to publish `ready` so the host's first read
# lands mid-write; a later read would only measure whole-file propagation.
set -eu

shared="$(cd "$(dirname "$0")/../.." && pwd)/target/guest-input-streaming"
stream="$shared/stream"

# Long enough to span many host polls, short enough to wait through.
lines=24
interval=0.1

mkdir -p "$shared"
rm -f "$stream" "$stream.eof" "$shared/ready"

append() {
  while [ ! -f "$shared/ready" ]; do
    sleep 0.05
  done

  : > "$stream"
  written=0
  sequence=1
  while [ "$sequence" -le "$lines" ]; do
    # Fixed width, so the byte count is exact without stat-ing the file under
    # test.
    line=$(printf 'line %04d of %04d' "$sequence" "$lines")
    printf '%s\n' "$line" >> "$stream"
    written=$((written + ${#line} + 1))
    sequence=$((sequence + 1))
    sleep "$interval"
  done

  # The marker carries the guest's byte count so the host needn't duplicate it.
  # Renamed into place so it never appears half-written.
  printf '%s\n' "$written" > "$shared/eof.partial"
  mv "$shared/eof.partial" "$stream.eof"
}

append &
appender=$!

# `test-one` is the entry that accepts arguments (feature and filter).
# --no-capture prints the measurement whether or not the test passes.
status=0
compostbin-host test-one \
  -p compostbin-test \
  --features integration \
  --no-capture \
  -E 'test(host_sees_guest_appends_as_they_happen)' || status=$?

kill "$appender" 2>/dev/null || true
exit "$status"
